# Copied values are loaded automatically when you start the CLI from this directory
# (or a child directory). Existing process env vars are not overwritten.
# AGENTHARNESS_NO_DOTENV=1
# AGENTHARNESS_ENV_FILE=

# Optional live-provider credentials. Keep these empty until you set your own keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_MODE=responses

# Procurement analysis defaults to the OpenAI-compatible provider. You can also
# switch to procurement_fake from the web settings for a fully offline demo.
AGENTHARNESS_PROCUREMENT_PROVIDER=openai
AGENTHARNESS_PROCUREMENT_MODEL=
AGENTHARNESS_PROCUREMENT_REASONING_EFFORT=
AGENTHARNESS_PROCUREMENT_INPUT_PER_MILLION_USD=
AGENTHARNESS_PROCUREMENT_OUTPUT_PER_MILLION_USD=
AGENTHARNESS_PROCUREMENT_CACHED_INPUT_PER_MILLION_USD=
AGENTHARNESS_PROCUREMENT_MAX_COST_USD=
AGENTHARNESS_PROCUREMENT_MAX_TOKENS=50000
AGENTHARNESS_PROCUREMENT_MAX_STEPS=20
AGENTHARNESS_PROCUREMENT_MAX_WALL_TIME_S=180

# ---- P2-1 LLM 网关（Python Agent 侧，按 provider 生效）----
# 并发配额：同 provider 同时在途请求上限（超出排队）
AGENTHARNESS_PROVIDER_MAX_CONCURRENCY=4
# QPS 限流：令牌桶速率（provider 维度），令牌等待超过上限即拒绝（429 语义）
AGENTHARNESS_PROVIDER_QPS=10
AGENTHARNESS_PROVIDER_BUCKET_WAIT_S=0.5
# 熔断：30s 滑动窗口失败率 > 50%（至少 5 个样本）→ 熔断 60s；半开探测成功后恢复
AGENTHARNESS_PROVIDER_CIRCUIT_WINDOW_S=30
AGENTHARNESS_PROVIDER_CIRCUIT_FAILURE_RATE=0.5
AGENTHARNESS_PROVIDER_CIRCUIT_MIN_SAMPLES=5
AGENTHARNESS_PROVIDER_CIRCUIT_OPEN_S=60

# Runtime data location.
AGENTHARNESS_DATA_DIR=~/.agentharness

# ---- 0.5.0 Java/Python + Kafka ----
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/caijiatai_business?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
PROCUREMENT_DATABASE_USER=procurement
PROCUREMENT_DATABASE_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
AGENT_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
AGENT_INTERNAL_HMAC_KEY=
MYSQL_ROOT_PASSWORD=
KAFKA_ADMIN_USERNAME=admin
KAFKA_ADMIN_PASSWORD=
KAFKA_JAVA_USERNAME=java-svc
KAFKA_JAVA_PASSWORD=
KAFKA_AGENT_USERNAME=python-agent
KAFKA_AGENT_PASSWORD=
APP_AGENT_MODE=kafka
APP_DEMO_SEED_ENABLED=false
APP_DEMO_SEED_ROOT=output/procurement-scenarios
