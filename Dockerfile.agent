FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/

RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ uv==0.8.22
WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY contracts ./contracts
RUN uv sync --no-dev

ENTRYPOINT ["/app/.venv/bin/python", "-m", "agentharness.agent_service"]