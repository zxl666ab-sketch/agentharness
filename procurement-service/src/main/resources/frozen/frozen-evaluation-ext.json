      "expect": {"interval": null}
    },
    {
      "id": "ref-interval-003",
      "description": "区间作为新增可选字段注入 AI 结构化结果，软提示风险 flag",
      "structured_result_hint": {
        "reference_price_interval": {
          "p25": "7500.00",
          "p75": "9400.00",
          "count": 3,
          "basis": "landed_total_base"
        },
        "risk_flags": ["PRICE_BELOW_REFERENCE"]
      }
    }
  ]
