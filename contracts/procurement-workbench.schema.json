{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caijiatai.local/contracts/procurement-workbench.schema.json",
  "title": "Caijiatai procurement workbench contract",
  "description": "Canonical public views and Kafka envelopes shared by Java, Python and Web.",
  "oneOf": [
    { "$ref": "#/$defs/AiTaskView" },
    { "$ref": "#/$defs/AiTaskRecordView" },
    { "$ref": "#/$defs/AiResultView" },
    { "$ref": "#/$defs/ReviewView" },
    { "$ref": "#/$defs/AiTaskCommandEnvelope" },
    { "$ref": "#/$defs/AiTaskEventEnvelope" }
  ],
  "x-ai-status-transitions": {
    "PENDING": ["DISPATCHING", "CANCELLED"],
    "DISPATCHING": ["RUNNING", "FAILED", "CANCELLED"],
    "RUNNING": ["SUCCEEDED", "FAILED", "CANCELLED"],
    "SUCCEEDED": [],
    "FAILED": ["RETRYING", "CANCELLED"],
    "RETRYING": ["RUNNING", "FAILED", "CANCELLED"],
    "CANCELLED": []
  },
  "x-wire-compatibility": {
    "aggregate_id": "Deprecated Kafka alias for business_id during the staged rollout.",
    "operation_type": "Deprecated Kafka alias; analyze maps to task_type QUOTE_ANALYSIS.",
    "analyzing": "Deprecated procurement status. AI execution is represented only by ai_status."
  },
  "$defs": {
    "Id32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "ProcurementStatus": {
      "type": "string",
      "enum": [
        "draft",
        "collecting",
        "review",
        "ready",
        "analyzed",
        "approval_pending",
        "approved",
        "no_award",
        "cancelled"
      ]
    },
    "SupplierStatus": {
      "type": "string",
      "enum": ["ACTIVE", "PAUSED", "BLACKLISTED"]
    },
    "CostSavings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_total", "landed_total", "savings", "included_tasks"],
      "properties": {
        "budget_total": { "type": "string" },
        "landed_total": { "type": "string" },
        "savings": { "type": "string" },
        "rate": { "type": ["string", "null"] },
        "included_tasks": { "type": "integer", "minimum": 0 }
      }
    },
    "InsightsOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_funnel", "cost_savings", "counts"],
      "properties": {
        "status_funnel": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "count"],
            "properties": {
              "status": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "cost_savings": { "$ref": "#/$defs/CostSavings" },
        "counts": { "type": "object", "additionalProperties": true }
      }
    },
    "InsightTrendRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "task_count", "approved_amount"],
      "properties": {
        "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "task_count": { "type": "integer", "minimum": 0 },
        "approved_amount": { "type": "string" }
      }
    },
    "AuditEventView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event_type", "actor", "payload", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/Id32" },
        "task_id": { "type": ["string", "null"] },
        "task_reference": { "type": ["string", "null"] },
        "quote_id": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "business_type": { "type": ["string", "null"] },
        "business_id": { "type": ["string", "null"] },
        "event_type": { "type": "string" },
        "actor": { "type": "string" },
        "payload": { "type": "object" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "PlatformInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "backend_version", "api_schema_version", "components", "parsers", "rulesets", "model", "db", "capabilities"],
      "properties": {
        "service": { "type": "string" },
        "backend_version": { "type": "string" },
        "api_schema_version": { "type": "integer" },
        "components": { "type": "object", "additionalProperties": true },
        "parsers": { "type": "object", "additionalProperties": true },
        "rulesets": { "type": "object", "additionalProperties": true },
        "model": { "type": "object", "additionalProperties": true },
        "db": { "type": "object", "additionalProperties": true },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "providers"],
          "properties": {
            "source": { "type": "string" },
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["provider", "state"],
                "properties": {
                  "provider": { "type": "string" },
                  "state": { "type": "string", "enum": ["open", "half_open", "degraded", "closed", "active"] },
                  "remaining_open_s": { "type": "number" },
                  "stats": { "type": "object", "additionalProperties": true },
                  "limits": { "type": "object", "additionalProperties": true },
                  "last_event": { "type": "string" },
                  "occurred_at": { "type": "string" }
                }
              }
            }
          }
        },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "QuoteCorrectionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value"],
      "properties": {
        "field": { "type": "string", "maxLength": 100 },
        "value": {},
        "chosen_from_conflicts": { "type": "boolean" }
      }
    },
    "CorrectionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_id", "task_reference", "quote_id", "supplier_name", "field", "old_value", "new_value", "chosen_from_conflicts", "actor", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "task_id": { "type": "string" },
        "task_reference": { "type": ["string", "null"] },
        "quote_id": { "type": "string" },
        "supplier_name": { "type": ["string", "null"] },
        "field": { "type": "string" },
        "old_value": {},
        "new_value": {},
        "chosen_from_conflicts": { "type": "boolean" },
        "actor": { "type": "string" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "CorrectionPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "page", "size", "total"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/CorrectionView" } },
        "page": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "InvoiceStatus": {
      "type": "string",
      "enum": ["REGISTERED", "MATCHED", "DIFF_HOLD", "VOIDED", "RECONCILED"]
    },
    "InvoiceMatchDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "expected", "actual", "diff"],
      "properties": {
        "field": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "diff": { "type": "string" }
      }
    },
    "InvoiceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order_id", "invoice_no", "total_amount", "supplier_name", "parser_version", "status", "version", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "order_id": { "type": "string" },
        "invoice_code": { "type": ["string", "null"] },
        "invoice_no": { "type": "string" },
        "issue_date": { "type": ["string", "null"] },
        "quantity": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "unit_price": { "type": ["string", "null"] },
        "amount_excluding_tax": { "type": ["string", "null"] },
        "tax_amount": { "type": ["string", "null"] },
        "total_amount": { "type": "string" },
        "tax_rate": { "type": ["string", "null"] },
        "supplier_name": { "type": "string" },
        "parser_version": { "type": "string" },
        "status": { "$ref": "#/$defs/InvoiceStatus" },
        "match_result": { "type": ["object", "null"], "additionalProperties": true },
        "match_explanation": { "type": ["object", "null"], "additionalProperties": true },
        "notes": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 0 },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" },
        "matched_at": { "type": ["string", "null"] },
        "reconciled_at": { "type": ["string", "null"] },
        "order_no": { "type": ["string", "null"] },
        "task_reference": { "type": ["string", "null"] },
        "order_quantity": { "type": ["string", "null"] },
        "order_received_quantity": { "type": ["string", "null"] },
        "order_landed_total": { "type": ["string", "null"] },
        "expected_tax_rate": { "type": ["string", "null"] },
        "three_way": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "InvoicePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "page", "size", "total"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/InvoiceView" } },
        "page": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "InvoiceActionInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quantity": { "type": ["number", "null"] },
        "unit_price": { "type": ["number", "null"] },
        "amount_excluding_tax": { "type": ["number", "null"] },
        "tax_amount": { "type": ["number", "null"] },
        "total_amount": { "type": ["number", "null"] },
        "tax_rate": { "type": ["number", "null"] },
        "confirmed": { "type": "boolean" },
        "notes": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "ProcurementRunAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "purchase_request_id", "status", "location"],
      "properties": {
        "operation_id": { "type": "string" },
        "purchase_request_id": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "ContractStatus": {
      "type": "string",
      "enum": ["DRAFT", "PENDING_APPROVAL", "EFFECTIVE", "EXECUTING", "CHANGE_REQUEST", "CLOSED"]
    },
    "ContractClause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content", "risk_level", "risk_reason"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "risk_level": { "type": "string" },
        "risk_reason": { "type": "string" }
      }
    },
    "ContractView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_no", "task_id", "supplier_name", "item_name", "amount", "lead_days", "status", "clauses", "version", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "contract_no": { "type": "string" },
        "task_id": { "type": "string" },
        "task_reference": { "type": ["string", "null"] },
        "order_id": { "type": ["string", "null"] },
        "order_no": { "type": ["string", "null"] },
        "supplier_name": { "type": "string" },
        "item_name": { "type": "string" },
        "amount": { "type": "string" },
        "lead_days": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/ContractStatus" },
        "draft_text": { "type": ["string", "null"] },
        "clauses": { "type": "array", "items": { "$ref": "#/$defs/ContractClause" } },
        "consistency": { "type": ["object", "null"], "additionalProperties": true },
        "clause_validation": { "type": ["object", "null"], "additionalProperties": true },
        "change_history": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
        "notes": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 0 },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" },
        "approved_at": { "type": ["string", "null"] }
      }
    },
    "ContractPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "page", "size", "total"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ContractView" } },
        "page": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "ContractActionInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirmed": { "type": "boolean" },
        "notes": { "type": ["string", "null"], "maxLength": 2000 },
        "new_amount": { "type": ["number", "null"] },
        "new_lead_days": { "type": ["number", "null"] }
      }
    },
    "OrderStatus": {
      "type": "string",
      "enum": ["PENDING_SHIPMENT", "SHIPPED", "RECEIVED", "CLOSED"]
    },
    "OrderAction": {
      "type": "string",
      "enum": ["ship", "receive", "close"]
    },
    "SettlementStatus": {
      "type": "string",
      "enum": ["UNSETTLED", "SETTLED", "PAID"]
    },
    "SettlementAction": {
      "type": "string",
      "enum": ["settle", "pay"]
    },
    "OrderArtifactView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "filename", "content_type", "size_bytes", "sha256", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "filename": { "type": "string" },
        "content_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "created_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "OrderSettlementView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "settlement_no", "total_amount", "status", "version", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/Id32" },
        "settlement_no": { "type": "string" },
        "total_amount": { "type": "string" },
        "status": { "$ref": "#/$defs/SettlementStatus" },
        "paid_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 0 },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "OrderView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task_id",
        "order_no",
        "supplier_name",
        "item_name",
        "quantity",
        "unit",
        "status",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id32" },
        "task_id": { "$ref": "#/$defs/Id32" },
        "order_no": { "type": "string" },
        "supplier_name": { "type": "string" },
        "item_name": { "type": "string" },
        "quantity": { "type": "string" },
        "unit": { "type": "string" },
        "landed_total": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/OrderStatus" },
        "received_quantity": { "type": ["string", "null"] },
        "arrival_date": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 0 },
        "task_reference": { "type": ["string", "null"] },
        "task_title": { "type": ["string", "null"] },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/OrderArtifactView" } },
        "settlement": {
          "oneOf": [{ "$ref": "#/$defs/OrderSettlementView" }, { "type": "null" }]
        },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "OrderTransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/OrderAction" },
        "received_quantity": { "type": ["string", "null"] },
        "arrival_date": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "SettlementView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order_id",
        "settlement_no",
        "supplier_name",
        "total_amount",
        "status",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id32" },
        "order_id": { "$ref": "#/$defs/Id32" },
        "settlement_no": { "type": "string" },
        "supplier_name": { "type": "string" },
        "total_amount": { "type": "string" },
        "status": { "$ref": "#/$defs/SettlementStatus" },
        "paid_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] },
        "version": { "type": "integer", "minimum": 0 },
        "order_no": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "SettlementTransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/SettlementAction" },
        "paid_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "SupplierPerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "score",
        "win_rate_score",
        "activity_score",
        "status_score",
        "base_score"
      ],
      "properties": {
        "level": { "type": "string" },
        "score": { "type": "string" },
        "win_rate_score": { "type": "string" },
        "activity_score": { "type": "string" },
        "status_score": { "type": "string" },
        "base_score": { "type": "string" }
      }
    },
    "SupplierView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "quote_count",
        "win_count",
        "win_rate",
        "performance",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id32" },
        "name": { "type": "string", "minLength": 1 },
        "contact_person": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "main_categories": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/SupplierStatus" },
        "notes": { "type": ["string", "null"] },
        "cooperation_status": { "type": "string" },
        "quote_count": { "type": "integer", "minimum": 0 },
        "win_count": { "type": "integer", "minimum": 0 },
        "win_rate": { "type": "string" },
        "performance": { "$ref": "#/$defs/SupplierPerformance" },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "SupplierSaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "contact_person": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "main_categories": { "type": ["string", "null"] },
        "status": {
          "oneOf": [{ "$ref": "#/$defs/SupplierStatus" }, { "type": "null" }]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "SupplierProfileQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote_id", "task_id", "source_filename", "created_at"],
      "properties": {
        "quote_id": { "$ref": "#/$defs/Id32" },
        "task_id": { "$ref": "#/$defs/Id32" },
        "task_reference": { "type": ["string", "null"] },
        "item_name": { "type": ["string", "null"] },
        "source_filename": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SupplierProfileView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "cooperation_status",
        "quote_count",
        "win_count",
        "win_rate",
        "performance",
        "items",
        "recent_quotes",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id32" },
        "name": { "type": "string", "minLength": 1 },
        "contact_person": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "main_categories": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/SupplierStatus" },
        "notes": { "type": ["string", "null"] },
        "cooperation_status": { "type": "string" },
        "quote_count": { "type": "string" },
        "win_count": { "type": "string" },
        "win_rate": { "type": "string" },
        "performance": { "$ref": "#/$defs/SupplierPerformance" },
        "items": { "type": "array", "items": { "type": "string" } },
        "recent_quotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/SupplierProfileQuote" }
        },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "AiTaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "DISPATCHING",
        "RUNNING",
